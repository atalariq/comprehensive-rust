": +---------------+ :           : +----------------+  :\n"
": |               | :           : |                |  :\n"
": |         o-----+-+-----------+-+->              |  :\n"
": |               | : Language  : |                |  :\n"
": +---------------+ : boundary  : +----------------+  :\n"
":                   :           :                     :\n"
"`- - - - - - - - - -'           `- - - - - - - - - - -'\n"
"```"
msgstr ""

