msgid "\"Hello, Macros!\""
msgstr "\"Hello, Macros!\""

#: src/macros/hygiene/what-is-hygiene.md
msgid "// In an unhygienic system, this would compile!\n"
msgstr "// In an unhygienic system, this would compile!\n"

#: src/macros/hygiene/what-is-hygiene.md
msgid "Example 2: Leaking Local Variables (Unhygienic)"
msgstr "Contoh 2: Membocorkan Variabel Lokal (Tidak Higienis)"

