msgstr "`slice::get(&self /* &[T] */, usize) -> Option<&T>`"

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/exercise.md
msgid ""
"`slice::get_unchecked_mut(&self /* &[T] */, usize) -> &T` (unsafe and "
"simplified)"
msgstr ""
"`slice::get_unchecked_mut(&self /* &[T] */, usize) -> &T` (unsafe dan "
"disederhanakan)"

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/exercise.md
msgid "`Option::as_ref(&self /* &Option<T> */) -> Option<&T>`"
msgstr "`Option::as_ref(&self /* &Option<T> */) -> Option<&T>`"

#: src/idiomatic/foundations-api-design/predictable-api/naming-conventions/exercise.md
msgid "`str::from_utf8_unchecked_mut(v: &mut [u8]) -> &mut str` (unsafe)"
msgstr "`str::from_utf8_unchecked_mut(v: &mut [u8]) -> &mut str` (unsafe)"

