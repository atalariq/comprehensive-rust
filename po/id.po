msgstr "\"Hello!\""

#: src/memory-management/move.md
msgid "// dbg!(s1);\n"
msgstr "// dbg!(s1);\n"

#: src/memory-management/move.md
msgid "The assignment of `s1` to `s2` transfers ownership."
msgstr "Assignment `s1` ke `s2` memindahkan ownership."

#: src/memory-management/move.md
msgid ""
"When `s1` goes out of scope, nothing happens: it does not own anything."
msgstr ""
"Ketika `s1` keluar dari scope, tidak ada yang terjadi karena tidak lagi "
"memiliki nilai apa pun."

#: src/memory-management/move.md
msgid "When `s2` goes out of scope, the string data is freed."
msgstr "Ketika `s2` keluar dari scope, data string dibebaskan."

#: src/memory-management/move.md
msgid "Before move to `s2`:"
msgstr "Sebelum dipindahkan ke `s2`:"

#: src/memory-management/move.md
msgid "After move to `s2`:"
msgstr "Setelah dipindahkan ke `s2`:"

