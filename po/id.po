msgstr "Ukuran tipe-tipe tersebut adalah:"

#: src/types-and-values/values.md
msgid "`iN`, `uN`, and `fN` are _N_ bits wide,"
msgstr "`iN`, `uN`, dan `fN` berukuran _N_ bit,"

#: src/types-and-values/values.md
