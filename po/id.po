msgstr "Ada beberapa shortcut keyboard yang berguna dalam mdBook:"

#: src/running-the-course/keyboard-shortcuts.md
msgid "<kbd>Arrow-Left</kbd>: Navigate to the previous page."
msgstr "<kbd>Arrow-Left</kbd>: Buka halaman sebelumnya."

#: src/running-the-course/keyboard-shortcuts.md
msgid "<kbd>Arrow-Right</kbd>: Navigate to the next page."
msgstr "<kbd>Arrow-Right</kbd>: Buka halaman berikutnya."

#: src/running-the-course/keyboard-shortcuts.md
